# Shared development infrastructure
# Copy this tracked placeholder template to .env and keep the resulting file private.

GOFURRY_DEV_PG_HOST=<TAILNET_HOST>
GOFURRY_DEV_PG_PORT=5432

GOFURRY_DEV_PG_APP_USER=gofurry_app
GOFURRY_DEV_PG_APP_PASSWORD=CHANGE_ME

GOFURRY_DEV_REDIS_ADDR=<TAILNET_HOST>:6379
GOFURRY_DEV_REDIS_USER=gofurry_app
GOFURRY_DEV_REDIS_PASSWORD=CHANGE_ME

# Goose only
GOFURRY_GFN_MIGRATOR_URL=postgres://gofurry_migrator:CHANGE_ME@<TAILNET_HOST>:5432/gfn?sslmode=disable
GOFURRY_GFG_MIGRATOR_URL=postgres://gofurry_migrator:CHANGE_ME@<TAILNET_HOST>:5432/gfg?sslmode=disable
GOFURRY_GFA_MIGRATOR_URL=postgres://gofurry_migrator:CHANGE_ME@<TAILNET_HOST>:5432/gfa?sslmode=disable
